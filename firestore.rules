rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.active == true
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function validNewUser(userId) {
      return isOwner(userId)
        && request.resource.data.keys().hasAll([
          'uid', 'fullName', 'email', 'role', 'active', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.keys().hasOnly([
          'uid', 'fullName', 'email', 'role', 'active', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.role == 'user'
        && request.resource.data.active == true
        && request.resource.data.fullName is string
        && request.resource.data.fullName.size() >= 2
        && request.resource.data.fullName.size() <= 80
        && request.resource.data.email is string
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
    }

    function validOwnerUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['fullName', 'updatedAt'])
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.email == resource.data.email
        && request.resource.data.role == resource.data.role
        && request.resource.data.active == resource.data.active
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.fullName is string
        && request.resource.data.fullName.size() >= 2
        && request.resource.data.fullName.size() <= 80
        && request.resource.data.updatedAt == request.time;
    }

    function validAppointmentStatus(status) {
      return status in ['pending', 'confirmed', 'completed', 'cancelled'];
    }

    function validAppointmentTime(time) {
      return time in ['09:00', '10:00', '11:00', '13:00', '14:00', '15:00', '16:00'];
    }

    function validAppointmentDate(date) {
      return date is string
        && date.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}');
    }

    function hasSlotKey(data) {
      return data.keys().hasAll(['slotKey'])
        && data.slotKey is string
        && data.slotKey == data.preferredDate + '__' + data.preferredTime;
    }

    function slotPath(slotKey) {
      return /databases/$(database)/documents/bookingSlots/$(slotKey);
    }

    function appointmentPath(appointmentId) {
      return /databases/$(database)/documents/appointments/$(appointmentId);
    }

    function validNewAppointment(appointmentId) {
      return signedIn()
        && request.resource.data.keys().hasAll([
          'id', 'userId', 'fullName', 'email', 'language', 'supportTopic',
          'preferredDate', 'preferredTime', 'contactPreference', 'notes',
          'slotKey', 'status', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.keys().hasOnly([
          'id', 'userId', 'fullName', 'email', 'language', 'supportTopic',
          'preferredDate', 'preferredTime', 'contactPreference', 'notes',
          'slotKey', 'status', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.id == appointmentId
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.fullName is string
        && request.resource.data.fullName.size() >= 2
        && request.resource.data.fullName.size() <= 80
        && request.resource.data.email is string
        && request.resource.data.email.size() >= 3
        && request.resource.data.email.size() <= 254
        && request.resource.data.language is string
        && request.resource.data.language.size() >= 1
        && request.resource.data.language.size() <= 80
        && request.resource.data.supportTopic is string
        && request.resource.data.supportTopic.size() >= 1
        && request.resource.data.supportTopic.size() <= 120
        && validAppointmentDate(request.resource.data.preferredDate)
        && validAppointmentTime(request.resource.data.preferredTime)
        && hasSlotKey(request.resource.data)
        && request.resource.data.contactPreference is string
        && request.resource.data.contactPreference in ['Email', 'Phone call', 'SMS']
        && request.resource.data.notes is string
        && request.resource.data.notes.size() <= 500
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && existsAfter(slotPath(request.resource.data.slotKey))
        && getAfter(slotPath(request.resource.data.slotKey)).data.appointmentId == appointmentId
        && getAfter(slotPath(request.resource.data.slotKey)).data.date
          == request.resource.data.preferredDate
        && getAfter(slotPath(request.resource.data.slotKey)).data.time
          == request.resource.data.preferredTime;
    }

    function validAdminAppointmentUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'updatedAt'])
        && validAppointmentStatus(request.resource.data.status)
        && request.resource.data.updatedAt == request.time
        && (
          !hasSlotKey(resource.data)
          || (
            request.resource.data.status == 'cancelled'
              ? !existsAfter(slotPath(resource.data.slotKey))
              : existsAfter(slotPath(resource.data.slotKey))
                && getAfter(slotPath(resource.data.slotKey)).data.appointmentId
                  == resource.data.id
          )
        );
    }

    function validNewBookingSlot(slotKey) {
      return signedIn()
        && request.resource.data.keys().hasAll([
          'slotKey', 'appointmentId', 'date', 'time', 'createdAt'
        ])
        && request.resource.data.keys().hasOnly([
          'slotKey', 'appointmentId', 'date', 'time', 'createdAt'
        ])
        && request.resource.data.slotKey == slotKey
        && validAppointmentDate(request.resource.data.date)
        && validAppointmentTime(request.resource.data.time)
        && slotKey == request.resource.data.date + '__' + request.resource.data.time
        && request.resource.data.appointmentId is string
        && request.resource.data.appointmentId.size() >= 1
        && request.resource.data.createdAt == request.time
        && existsAfter(appointmentPath(request.resource.data.appointmentId))
        && getAfter(appointmentPath(request.resource.data.appointmentId)).data.slotKey == slotKey
        && getAfter(appointmentPath(request.resource.data.appointmentId)).data.preferredDate
          == request.resource.data.date
        && getAfter(appointmentPath(request.resource.data.appointmentId)).data.preferredTime
          == request.resource.data.time
        && getAfter(appointmentPath(request.resource.data.appointmentId)).data.status
          in ['pending', 'confirmed', 'completed']
        && (
          isOwner(getAfter(appointmentPath(request.resource.data.appointmentId)).data.userId)
          || isAdmin()
        );
    }

    function canReleaseBookingSlot() {
      return exists(appointmentPath(resource.data.appointmentId))
        && (
          isOwner(get(appointmentPath(resource.data.appointmentId)).data.userId)
          || isAdmin()
        )
        && (
          !existsAfter(appointmentPath(resource.data.appointmentId))
          || getAfter(appointmentPath(resource.data.appointmentId)).data.status == 'cancelled'
        );
    }

    function validRatingScore(score) {
      return score is int && score >= 1 && score <= 5;
    }

    function validNewRating(ratingId) {
      return signedIn()
        && request.resource.data.keys().hasAll([
          'userId', 'resourceId', 'score', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.keys().hasOnly([
          'userId', 'resourceId', 'score', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.resourceId is string
        && request.resource.data.resourceId.size() >= 1
        && request.resource.data.resourceId.size() <= 120
        && ratingId == request.auth.uid + '__' + request.resource.data.resourceId
        && validRatingScore(request.resource.data.score)
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
    }

    function validRatingUpdate() {
      return isOwner(resource.data.userId)
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['score', 'updatedAt'])
        && validRatingScore(request.resource.data.score)
        && request.resource.data.updatedAt == request.time;
    }

    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
      allow create: if validNewUser(userId);
      allow update: if isOwner(userId) && validOwnerUpdate();
      allow delete: if false;
    }

    match /appointments/{appointmentId} {
      allow create: if validNewAppointment(appointmentId);
      allow read: if isOwner(resource.data.userId) || isAdmin();
      allow update: if isAdmin() && validAdminAppointmentUpdate();
      allow delete: if isOwner(resource.data.userId)
        && (
          !hasSlotKey(resource.data)
          || !existsAfter(slotPath(resource.data.slotKey))
        );
    }

    match /bookingSlots/{slotKey} {
      allow read: if signedIn();
      allow create: if validNewBookingSlot(slotKey);
      allow update: if false;
      allow delete: if canReleaseBookingSlot();
    }

    match /ratings/{ratingId} {
      allow read: if true;
      allow create: if validNewRating(ratingId);
      allow update: if validRatingUpdate();
      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
